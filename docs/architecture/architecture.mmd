---
title: System Architecture - Neural Word Embeddings
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#EEF2FF"
    clusterBorder: "#94A3B8"
---
flowchart TB
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Client([Client]):::edge

    subgraph Train["Training (once at startup)"]
        direction TB
        Corpus[(Structured corpus)]:::data
        Vocab[Vocabulary<br/>frequency-ordered]:::core
        SkipGram["Skip-gram + negative sampling<br/>hand-derived gradients"]:::core
    end

    subgraph Edge["Service layer (stdlib HTTP, stateless)"]
        direction TB
        Router["Router<br/>/health | /ready | /metrics | /similar | /analogy"]:::core
        Validate["Validation<br/>known word, bounded k"]:::control
    end

    Vectors[(Embedding matrix)]:::data
    Result["Nearest neighbors / analogy<br/>+ cosine scores"]:::obs

    Corpus --> Vocab --> SkipGram -->|center vectors| Vectors
    Client -->|JSON request| Router --> Validate
    Validate -->|word| Vectors
    Vectors -->|cosine ranking| Result
    Result --> Router -->|JSON response| Client
