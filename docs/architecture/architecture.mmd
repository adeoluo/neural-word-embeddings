flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Cli(["CLI<br/>evaluate, similar, serve"]):::edge
        Client(["HTTP client<br/>JSON query"]):::edge
        Router["HTTP router<br/>/similar, /analogy"]:::core
        Validate["Validation<br/>known words, k 1 to 25"]:::control
        Cli ~~~ Client --> Router --> Validate
    end

    subgraph Core["Training and queries"]
        direction TB
        Config["TrainingConfig<br/>window, negatives, seed"]:::control
        Vocab["Vocabulary<br/>frequency-ordered"]:::core
        Neg["Negative sampler<br/>unigram to the 3/4"]:::core
        SkipGram["Skip-gram SGD<br/>hand-derived gradients"]:::core
        Query["Similarity, analogy<br/>cosine ranking"]:::core
        Config ~~~ Vocab --> Neg --> SkipGram ~~~ Query
    end

    subgraph State["Data and state"]
        direction TB
        Corpus[("Bundled corpus<br/>five categories")]:::data
        Center[("Center matrix<br/>word vectors")]:::data
        Context[("Context matrix<br/>training only")]:::data
        Corpus ~~~ Center ~~~ Context
    end

    subgraph Obs["Evaluation and outputs"]
        direction TB
        Results["Neighbors JSON<br/>words and cosines"]:::obs
        Loss["Training loss<br/>per epoch"]:::obs
        Eval["Category retrieval<br/>vs random baseline"]:::obs
        Metrics["/metrics<br/>Prometheus text"]:::obs
        Results ~~~ Loss ~~~ Eval ~~~ Metrics
    end

    Interfaces -->|words, k| Core
    Core -->|reads, updates| State
    State -.->|vectors| Obs
    Core -->|answers, loss| Obs
